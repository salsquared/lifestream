{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    // Root `npm run typecheck` is `tsc -b`, and the base config is composite, so a
    // .tsbuildinfo is always written. Park it under the (gitignored) node_modules
    // instead of leaving it in the repo tree.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src", "vite.config.ts"]
}
