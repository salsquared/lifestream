{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Specs are typechecked, never emitted, so this project opts out of the build graph
    // that `composite` in the base config opts every workspace into. Root `npm run
    // typecheck` is `tsc -b client server shared` and does not reference `tests/`.
    "composite": false,
    // The specs reach into `client/src` through `@client/*` (see aliases.mjs), and that
    // code is browser code: `reducedMotion.ts` reads `window.matchMedia`, `cameraChannel`
    // is a `useSyncExternalStore` source. DOM is in the lib set so those typecheck here;
    // it does NOT leak to shared/, which stays isomorphic via its own `"types": []`.
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "declaration": false,
    // `aliases.mjs` is plain JS (the tsconfig cannot import it, but Vite, Vitest and
    // this spec all can), so the alias spec needs JS in the program. Left unchecked:
    // the module is validated by the assertions in smoke.test.ts, not by `tsc`.
    "types": ["node"]
  },
  // The three alias consumers are pulled in so the spec that compares them typechecks
  // against the real configs rather than redeclared copies of their tables.
  "include": ["**/*.ts", "../aliases.mjs", "../vitest.config.ts", "../client/vite.config.ts"]
}
